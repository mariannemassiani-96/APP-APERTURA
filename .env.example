# ─────────────────────────────────────────────────────────────────────────────
# Projet Lumen — configuration de la couche LLM (cerveau de langage)
# ─────────────────────────────────────────────────────────────────────────────
# Copier ce fichier en `.env.local` et renseigner les valeurs souhaitées.
# AUCUNE clé n'est codée en dur : tout passe par ces variables.

# Fournisseur LLM actif. Valeurs possibles :
#   echo      -> mode hors-ligne, réponses déterministes ancrées sur les faits (défaut)
#   anthropic -> API Anthropic (Claude)
#   openai    -> API OpenAI
#   agent0    -> notre agent RAG existant (FastAPI + ChromaDB) — stub pour l'instant
LLM_PROVIDER=echo

# Clé API du fournisseur (inutile en mode `echo`).
LLM_API_KEY=

# Modèle à utiliser (dépend du fournisseur). Exemples :
#   anthropic -> claude-sonnet-5
#   openai    -> gpt-4o-mini
LLM_MODEL=

# URL de base pour Agent 0 (RAG interne), utilisée uniquement si LLM_PROVIDER=agent0.
AGENT0_BASE_URL=http://localhost:8000
